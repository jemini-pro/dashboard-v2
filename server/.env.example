# Copy to .env and fill in. Never commit .env.
DASH_PORT=8000

# Required. Agents send it as X-Dash-Token; generate with: openssl rand -hex 24
DASH_TOKEN=

# Memory total, used when the cgroup limit reads 'max' (2G matches the LXC)
DASH_MEM_TOTAL=2G

# Optional: only if a guest can actually reach the Proxmox API
PVE_HOST=
PVE_NODE=pve
PVE_TOKEN=
