# Copy to .env and fill in. Never commit .env.
DASH_PORT=8000

# Required. Agents send it as X-Dash-Token; generate with: openssl rand -hex 24
DASH_TOKEN=

# Memory total, used when the cgroup limit reads 'max' (2G matches the LXC)
DASH_MEM_TOTAL=2G

# Required by the Caddy edge for the browser password. Generate with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Then put the hash (not the password) here.
DASH_AUTH_HASH=

# Bind the published port to the LXC address, not every interface.
DASH_BIND=10.10.10.20

# Optional history tuning. The sampler runs server-side every 60 s and keeps
# raw samples for 30 days in data/metrics.db.
DASH_SAMPLE_SECONDS=60
DASH_HISTORY_DAYS=30
