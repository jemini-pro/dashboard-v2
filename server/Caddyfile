# One entry point on 8448. TLS is terminated by Tailscale on the host.
:8448 {
	encode {
		gzip 9
		zstd
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Agent heartbeats carry X-Dash-Token and must not need a browser password.
	@push path /api/push/*
	handle @push {
		reverse_proxy dash:8000
	}

	# The installers and the agent copies they fetch carry no secrets (the token
	# lives in a separate file on the device). They are read by machines, which
	# cannot answer a password prompt, and an installed agent re-reads its own
	# copy from here to stay current. Publishing them is what makes install and
	# self-update work.
	@agents path /agents/*
	handle @agents {
		reverse_proxy dash:8000
	}

	# Everything else: one password, asked once per browser session.
	handle {
		basic_auth {
			jem {$DASH_AUTH_HASH}
		}
		reverse_proxy dash:8000
	}
}
